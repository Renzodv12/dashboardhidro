# Copiar a .env.hardware. Perfil de monitoreo, sin dosificación física.
SECRET_KEY=
DATABASE_PATH=data/hidroponia-hardware.sqlite3
HOST=127.0.0.1
PORT=5002
SIMULATION_ENABLED=false
MQTT_HOST=raspberrypi.local
MQTT_PORT=8883
MQTT_TLS=true
# CA que firma el certificado del broker propio (ruta local, nunca clave privada).
MQTT_CA_FILE=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=hidroponia/granja01
CONTROL_DEVICE_ID=esp32-01
