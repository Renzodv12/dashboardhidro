# Configuración compartible. Copiar a .env; NO versionar el archivo .env real.
# Restaurar backups/shared/local.sql.gz en esta ruta con restore_shared_backup.py.
DATABASE_PATH=data/hidroponia.sqlite3
# Completar localmente con: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
HOST=127.0.0.1
PORT=5000
HYDRO_DEBUG=false
LOG_LEVEL=INFO
SIMULATION_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=hidroponia
MQTT_TLS=false
CONTROL_DEVICE_ID=simulator-01
CAMERA_INDEX=0
